{
  "manifest_version": 3,
  "name": "KeyBit",
  "short_name": "KeyBit",
  "version": "1.3.0",
  "minimum_chrome_version": "127",
  "description": "A private, local-only encrypted vault that suggests logins in sign-in fields and offers to save passwords.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "unlimitedStorage",
    "clipboardWrite",
    "idle",
    "offscreen",
    "favicon"
  ],
  "optional_permissions": [
    "clipboardRead"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "src/background/service-worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["src/peek/peek-frame-events.js"],
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "src/content/form-detector.js",
        "src/content/autofill.js",
        "src/content/inline.js",
        "src/content/save.js",
        "src/content/passkey.js",
        "src/peek/peek-utils.js",
        "src/peek/peek-settings.js",
        "src/peek/peek-frame.js",
        "src/peek/peek-overlay.js",
        "src/peek/peek-link-handler.js",
        "src/peek/peek-controller.js"
      ],
      "run_at": "document_start",
      "all_frames": false
    },
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "src/content/passkey-page.js"
      ],
      "run_at": "document_start",
      "all_frames": false,
      "world": "MAIN"
    }
  ],
  "action": {
    "default_title": "KeyBit",
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+K",
        "mac": "Command+Shift+K"
      },
      "description": "Open the KeyBit popup"
    },
    "show-suggestions": {
      "suggested_key": {
        "default": "Alt+Shift+L",
        "mac": "Alt+Shift+L"
      },
      "description": "Show KeyBit in the focused login field"
    }
  },
  "options_ui": {
    "page": "src/vault-ui/vault.html",
    "open_in_tab": true
  },
  "content_security_policy": {
    "extension_pages": "default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self'; font-src 'self'; connect-src 'none'; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'self' http: https:"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "src/inline/panel.html",
        "src/inline/save.html",
        "src/inline/passkey.html",
        "src/peek/peek.css"
      ],
      "matches": [
        "http://*/*",
        "https://*/*"
      ]
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
