{
  "name": "keybit",
  "private": true,
  "version": "1.3.0",
  "type": "module",
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json",
    "check": "npm run lint && npm run typecheck",
    "package": "rm -f keybit.zip && zip -qr keybit.zip manifest.json icons src -x '*.DS_Store' && echo 'Created keybit.zip'",
    "release": "node scripts/release.mjs",
    "store:assets": "node scripts/store-assets.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/chrome": "^0.3.4",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "typescript": "^5.9.3"
  }
}
